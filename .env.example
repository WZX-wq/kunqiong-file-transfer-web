PORT=8045
# 测试/生产服务器一般保持 0.0.0.0，便于外网通过服务器 IP 或域名访问。
KUNQIONG_HOST=0.0.0.0
# 本地开发用 http://localhost:8045，线上部署改成正式域名（不要把真实服务器 IP 提交到仓库）。
KUNQIONG_APP_URL=http://localhost:8045
KUNQIONG_AUTH_CALLBACK_URL=http://localhost:8045/auth/callback
KUNQIONG_OAUTH_AUTHORIZE_URL=https://login.kunqiongai.com/authorize.html
KUNQIONG_OAUTH_TOKEN_URL=https://login.kunqiongai.com/api/oauth/token
# 正式环境的 client_id / client_secret 只放服务器 .env 与 CI Secrets，此处留空。
KUNQIONG_OAUTH_CLIENT_ID=
KUNQIONG_OAUTH_CLIENT_SECRET=
# 逗号分隔的鲲穹账号 ID，仅这些账号可以访问 /admin。
KUNQIONG_ADMIN_USER_IDS=
# Required for administrator password login; no built-in credentials.
KUNQIONG_ADMIN_USERNAME=
KUNQIONG_ADMIN_PASSWORD=
# ClamAV daemon; required mode blocks publication/readback without a successful scan.
KUNQIONG_SCAN_MODE=required
KUNQIONG_CLAMAV_HOST=127.0.0.1
KUNQIONG_CLAMAV_PORT=3310
# Includes sending the bytes plus the scanner's 10-minute processing budget.
KUNQIONG_SCAN_TIMEOUT_MS=900000
# 真实邮件投递配置。SMTP 密码建议使用邮箱服务商提供的授权码/应用专用密码。
KUNQIONG_SMTP_HOST=
KUNQIONG_SMTP_PORT=465
KUNQIONG_SMTP_SECURE=true
KUNQIONG_SMTP_USER=
KUNQIONG_SMTP_PASSWORD=
KUNQIONG_SMTP_FROM=
KUNQIONG_SMTP_FROM_NAME=鲲穹文件传输
# 腾讯云邮件模板标识。当前 SMTP 链路使用站内 HTML 模板发送，保留此值供后续模板 API 接入。
KUNQIONG_SMTP_TEMPLATE_ID=
# 腾讯云短信配置。模板文案见 notification-templates/sms-templates.json。
KUNQIONG_SMS_PROVIDER=tencent-cloud
KUNQIONG_TENCENT_SECRET_ID=
KUNQIONG_TENCENT_SECRET_KEY=
KUNQIONG_TENCENT_SMS_SDK_APP_ID=
KUNQIONG_TENCENT_SMS_SIGN_NAME=
KUNQIONG_TENCENT_SMS_REGION=ap-guangzhou
KUNQIONG_TENCENT_SMS_TEMPLATE_BIND_CODE_ID=
KUNQIONG_TENCENT_SMS_TEMPLATE_LOGIN_CODE_ID=
KUNQIONG_TENCENT_SMS_TEMPLATE_PASSWORD_CODE_ID=
KUNQIONG_TENCENT_SMS_TEMPLATE_WORKSPACE_INVITE_ID=
KUNQIONG_TENCENT_SMS_TEMPLATE_FILE_SHARE_ID=
KUNQIONG_TENCENT_SMS_TEMPLATE_MEMBERSHIP_ACTIVATED_ID=
KUNQIONG_TENCENT_SMS_TEMPLATE_MEMBERSHIP_EXPIRING_ID=
# 数据库配置。开启后首次启动会把 storage/metadata.json 迁移到 kunqiong_app_state。
KUNQIONG_DB_ENABLED=false
KUNQIONG_DB_HOST=
KUNQIONG_DB_PORT=3306
KUNQIONG_DB_NAME=
KUNQIONG_DB_USER=
KUNQIONG_DB_PASSWORD=
KUNQIONG_DB_CONNECTION_LIMIT=5
# 子站会员支付主站接口。当前默认映射：会员版=1、团队版=2、企业版=5；正式环境建议按主站实际套餐 ID 覆盖。
KUNQIONG_WEB_MEMBER_API_BASE=https://api-web.kunqiongai.com
KUNQIONG_WEB_MEMBER_SUBSITE_NAME=
KUNQIONG_WEB_MEMBER_PACKAGE_MEMBER_ID=
KUNQIONG_WEB_MEMBER_PACKAGE_TEAM_ID=
KUNQIONG_WEB_MEMBER_PACKAGE_ENTERPRISE_ID=
